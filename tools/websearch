#!/usr/bin/env python3
"""websearch: search the web through a SearXNG instance, for a local agent.

    websearch QUERY... [--count N]      (default 5, at most 20)

Prints numbered results: title, URL, snippet. Read a result with webread.

SearXNG is a free metasearch engine you run yourself (docs/searxng.md);
no account or key is needed. Its address is, in this order:
    AI_APP_SEARXNG_URL
    the file `searxng-url` in AI App's settings folder:
        Linux    ~/.config/ai-app/searxng-url   ($XDG_CONFIG_HOME if set)
        macOS    ~/Library/Application Support/ai-app/searxng-url
        Windows  %APPDATA%\\ai-app\\searxng-url
    http://127.0.0.1:8899 (what scripts/install-searxng.sh sets up)
SearXNG must allow the JSON output (`search.formats: [html, json]`).
Failures print one line on stderr and exit 2. Standard library only.
"""

from __future__ import annotations

import argparse
import html
import json
import os
import pathlib
import re
import sys
import urllib.error
import urllib.parse
import urllib.request

DEFAULT_URL = "http://127.0.0.1:8899"
TIMEOUT = 20
USER_AGENT = "ai-app-websearch/1"
SETUP = "see docs/searxng.md"


class Fail(Exception):
    pass


def settings_file() -> pathlib.Path:
    home = pathlib.Path(os.environ.get("HOME") or pathlib.Path.home())
    if sys.platform == "win32":
        base = pathlib.Path(os.environ.get("APPDATA") or home / "AppData" / "Roaming")
    elif sys.platform == "darwin":
        base = home / "Library" / "Application Support"
    else:
        base = pathlib.Path(os.environ.get("XDG_CONFIG_HOME") or home / ".config")
    return base / "ai-app" / "searxng-url"


def searxng_url() -> str:
    url = os.environ.get("AI_APP_SEARXNG_URL", "").strip()
    if not url:
        try:
            url = settings_file().read_text().strip()
        except OSError:
            url = ""
    url = (url or DEFAULT_URL).rstrip("/")
    if not url.lower().startswith(("http://", "https://")):
        raise Fail(f"the SearXNG address must start with http:// or https:// (got {url})")
    return url


def clean(s: str) -> str:
    return " ".join(html.unescape(re.sub(r"<[^>]+>", "", s or "")).split())


def search(query: str) -> list[dict]:
    base = searxng_url()
    url = f"{base}/search?" + urllib.parse.urlencode({"q": query, "format": "json"})
    req = urllib.request.Request(url, headers={"Accept": "application/json",
                                               "User-Agent": USER_AGENT})
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
            raw = r.read(4 * 1024 * 1024)
    except urllib.error.HTTPError as e:
        if e.code == 403:
            raise Fail(f"SearXNG at {base} refuses JSON (HTTP 403): add json to "
                       f"search.formats in its settings.yml, {SETUP}")
        if e.code == 429:
            raise Fail(f"SearXNG at {base} is rate limiting (HTTP 429): turn its limiter off, {SETUP}")
        raise Fail(f"SearXNG at {base} answered HTTP {e.code}")
    except urllib.error.URLError as e:
        raise Fail(f"SearXNG is not running at {base} ({e.reason}): {SETUP}")
    except (TimeoutError, OSError) as e:
        raise Fail(f"SearXNG is not running at {base} ({e}): {SETUP}")
    try:
        data = json.loads(raw)
    except ValueError:
        raise Fail(f"SearXNG at {base} did not answer in JSON: is it SearXNG? {SETUP}")
    return data.get("results") or []


class _Args(argparse.ArgumentParser):
    def error(self, message):  # one line, for the agent
        print(f"websearch: {message}", file=sys.stderr)
        sys.exit(2)


def main(argv: list[str] | None = None) -> int:
    ap = _Args(prog="websearch", description="Search the web (SearXNG).")
    ap.add_argument("--count", type=int, default=5)
    # Only --count is an option; every other word, "-site:x" included,
    # is the query, in the order typed.
    argv = list(sys.argv[1:] if argv is None else argv)
    opts, words, i = [], [], 0
    while i < len(argv):
        w = argv[i]
        if w == "--count" and i + 1 < len(argv):
            opts += argv[i:i + 2]
            i += 2
            continue
        if w.startswith("--count=") or w in ("-h", "--help"):
            opts.append(w)
        elif w != "--":
            words.append(w)
        i += 1
    a = ap.parse_args(opts)
    query = " ".join(words).strip()
    if not query:
        print("websearch: give a query, e.g. websearch flutter pty windows", file=sys.stderr)
        return 2
    count = min(max(a.count, 1), 20)
    try:
        results = search(query)
    except Fail as e:
        print("websearch: " + " ".join(str(e).split()), file=sys.stderr)
        return 2
    except Exception as e:  # one line, never a traceback, for the agent
        print(f"websearch: {type(e).__name__}: " + " ".join(str(e).split()), file=sys.stderr)
        return 2
    if not results:
        print(f"No results for: {query}")
        return 0
    out = []
    for n, r in enumerate(results[:count], 1):
        out.append(f"{n}. {clean(r.get('title', ''))}\n   {r.get('url', '')}\n"
                   f"   {clean(r.get('content', ''))}")
    print("\n".join(out))
    return 0


if __name__ == "__main__":
    sys.exit(main())
