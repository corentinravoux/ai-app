#!/usr/bin/env python3
"""webread: print a web page as plain text, capped, for a local coding agent.

    webread URL [--max-chars N]      (default 12000)

http and https only; 20 s timeout; at most 5 redirects; reads at most 2 MB.
HTML becomes its title, a blank line, then the visible text (scripts,
styles, navigation and SVG dropped). text/* and JSON pass through. A page
longer than N characters keeps its first 2/3 and last 1/3 around an
omission marker. Failures print one line on stderr and exit 2.
Standard library only.
"""

from __future__ import annotations

import argparse
import html.parser
import re
import sys
import urllib.error
import urllib.request

MAX_BYTES = 2 * 1024 * 1024
TIMEOUT = 20
MAX_REDIRECTS = 5
USER_AGENT = "ai-app-webread/1"

SKIP = {"script", "style", "nav", "svg", "noscript", "template", "head", "iframe"}
BLOCK = {
    "p", "div", "section", "article", "main", "header", "footer", "aside",
    "h1", "h2", "h3", "h4", "h5", "h6", "li", "ul", "ol", "tr", "table",
    "pre", "blockquote", "br", "hr", "dd", "dt", "figcaption", "form",
}


class Fail(Exception):
    pass


class _Text(html.parser.HTMLParser):
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.title = ""
        self.parts: list[str] = []
        self._skip = 0
        self._in_title = False
        self._pre = 0

    def handle_starttag(self, tag, attrs):
        if tag == "title":
            self._in_title = True
        if tag in SKIP:
            self._skip += 1
        if tag == "pre":
            self._pre += 1
        if tag in BLOCK:
            self.parts.append("\n")

    def handle_startendtag(self, tag, attrs):
        if tag in BLOCK:
            self.parts.append("\n")

    def handle_endtag(self, tag):
        if tag == "title":
            self._in_title = False
        if tag in SKIP and self._skip:
            self._skip -= 1
        if tag == "pre" and self._pre:
            self._pre -= 1
        if tag in BLOCK:
            self.parts.append("\n")

    def handle_data(self, data):
        if self._in_title:
            self.title += data
            return
        if self._skip:
            return
        self.parts.append(data if self._pre else re.sub(r"[ \t\r\f\v]+", " ", data))


def html_to_text(page: str) -> str:
    p = _Text()
    p.feed(page)
    p.close()
    body = "".join(p.parts)
    lines = [ln.strip() for ln in body.split("\n")]
    text = re.sub(r"\n{3,}", "\n\n", "\n".join(lines)).strip()
    title = " ".join(p.title.split())
    return f"{title}\n\n{text}" if title else text


def cap(text: str, n: int) -> str:
    if len(text) <= n:
        return text
    head, tail = n * 2 // 3, n // 3
    omitted = len(text) - head - tail
    return f"{text[:head]}\n[... {omitted} characters omitted ...]\n{text[-tail:]}"


class _Redirects(urllib.request.HTTPRedirectHandler):
    max_redirections = MAX_REDIRECTS
    max_repeats = 2

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if not newurl.lower().startswith(("http://", "https://")):
            raise Fail(f"refusing redirect to {newurl}")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def _charset(ctype_header: str, raw: bytes) -> str:
    m = re.search(r"charset=([\w.-]+)", ctype_header, re.I)
    if m:
        return m.group(1)
    m = re.search(rb"""<meta[^>]+charset=["']?([\w.-]+)""", raw[:4096], re.I)
    return m.group(1).decode("ascii", "replace") if m else "utf-8"


def fetch(url: str) -> tuple[str, str]:
    if not url.lower().startswith(("http://", "https://")):
        raise Fail("only http and https URLs can be read")
    opener = urllib.request.build_opener(_Redirects())
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Accept": "*/*"})
    try:
        with opener.open(req, timeout=TIMEOUT) as r:
            ctype_header = r.headers.get("Content-Type", "")
            raw = r.read(MAX_BYTES + 1)[:MAX_BYTES]
    except urllib.error.HTTPError as e:
        reason = " ".join(str(e.reason).split())
        raise Fail(f"HTTP {e.code} {reason} for {url}")
    except urllib.error.URLError as e:
        raise Fail(f"cannot fetch {url}: {e.reason}")
    except (TimeoutError, OSError) as e:
        raise Fail(f"cannot fetch {url}: {e}")
    ctype = ctype_header.split(";")[0].strip().lower() or "text/html"
    if not (ctype.startswith("text/") or ctype in ("application/json", "application/xhtml+xml", "application/xml")):
        raise Fail(f"cannot read {ctype}")
    try:
        text = raw.decode(_charset(ctype_header, raw), errors="replace")
    except LookupError:
        text = raw.decode("utf-8", errors="replace")
    return ctype, text


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="webread", description="Print a web page as plain text.")
    ap.add_argument("url")
    ap.add_argument("--max-chars", type=int, default=12000)
    a = ap.parse_args(argv)
    try:
        ctype, page = fetch(a.url)
    except Fail as e:
        print("webread: " + " ".join(str(e).split()), file=sys.stderr)
        return 2
    except Exception as e:  # one line, never a traceback, for the agent
        print(f"webread: {type(e).__name__}: " + " ".join(str(e).split()), file=sys.stderr)
        return 2
    text = html_to_text(page) if ctype in ("text/html", "application/xhtml+xml") else page
    print(cap(text, max(a.max_chars, 200)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
